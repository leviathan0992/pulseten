# PulseTen formatting: Google base with MySQL/InnoDB adjustments.
BasedOnStyle: Google
Language: Cpp
Standard: c++20
ColumnLimit: 80
DerivePointerAlignment: false
PointerAlignment: Right
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: Inline
IncludeBlocks: Regroup
# A module's main header also comes first in split implementation/test files.
IncludeIsMainRegex: '([-_].*)?$'
SortIncludes: CaseSensitive
IncludeCategories:
  # Keep the public interface first in examples, tests and API implementations.
  - Regex: '^[<"]pulseten\.h[>"]$'
    Priority: 0
  # C standard library headers.
  - Regex: '^<(assert|complex|ctype|errno|fenv|float|inttypes|iso646|limits|locale|math|setjmp|signal|stdalign|stdarg|stdatomic|stdbool|stddef|stdint|stdio|stdlib|stdnoreturn|string|tgmath|threads|time|uchar|wchar|wctype)\.h>$'
    Priority: 1
  # C++ standard library headers.
  - Regex: '^<[^./]+>$'
    Priority: 1
  # System and third-party headers, including quoted DuckDB paths.
  - Regex: '^<.*>$|^"duckdb/'
    Priority: 2
  # Project headers.
  - Regex: '.*'
    Priority: 3
