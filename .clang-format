# PulseTen formatting: Google base with MySQL/InnoDB adjustments.
BasedOnStyle: Google
Language: Cpp
Standard: c++20
ColumnLimit: 80
DerivePointerAlignment: false
PointerAlignment: Right
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: Inline
IncludeBlocks: Regroup
# A module's main header also comes first in split implementation/test files.
IncludeIsMainRegex: '([-_].*)?$'
SortIncludes: CaseSensitive
IncludeCategories:
  # The public C API is an interface header, including in examples and tests.
  - Regex: '^[<"]pulseten\.h[>"]$'
    Priority: 0
    SortPriority: 1
  # DuckDB C headers and C++ paths belong together, regardless of delimiters.
  - Regex: '^<duckdb[^>]*>$|^"duckdb/'
    Priority: 3
    SortPriority: 4
  - Regex: '^<.*\.h>$'
    Priority: 1
    SortPriority: 2
  - Regex: '^<.*>$'
    Priority: 2
    SortPriority: 3
  - Regex: '.*'
    Priority: 4
    SortPriority: 5
